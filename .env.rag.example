POSTGRES_HOST=host.docker.internal
POSTGRES_HOST_PORT=6024
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_db
EMBEDDING_DIM=768

OLLAMA_NOMIC_EMBED_TEXT_HOST=host.docker.internal
OLLAMA_NOMIC_EMBED_TEXT_HOST_PORT=11437
OLLAMA_NOMIC_EMBED_TEXT_MODEL=nomic-embed-text

OLLAMA_LLAMA31_HOST=host.docker.internal
OLLAMA_LLAMA31_HOST_PORT=11436
OLLAMA_LLAMA31_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=10m

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=2
RETRIEVE_FETCH_K=20
SIMILARITY_THRESHOLD=0.0

HYBRID_ENABLED=true
LEXICAL_FETCH_K=20
RRF_K=60
TEXT_SEARCH_CONFIG=simple

RERANK_ENABLED=true
RERANK_BACKEND=cross_encoder
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
RERANK_TOP_N=4
RERANK_MIN_SCORE=
RERANK_CACHE_DIR=/opt/rerank-cache

MAX_CONTEXT_CHARS=6000
HTTP_TIMEOUT_SECONDS=180
LLM_LOG_ENABLED=false
LLM_LOG_FULL_CONTENT=false
LLM_LOG_MAX_CHARS=16000
LLM_LOG_FILE=/app/logs/llm.log
INPUT_DIR=/app/input
